state.red-16line {
	control.1 {
		iface MIXER
		name 'Clock Source'
		value Internal
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 Internal
			item.1 Wordclock
			item.2 'ADAT 1'
			item.3 'ADAT 2'
			item.4 'S/PDIF'
			item.5 Dante
			item.6 'Loop Sync'
		}
	}
	control.2 {
		iface MIXER
		name 'Sync Status'
		value Locked
		comment {
			access 'read volatile'
			type ENUMERATED
			count 1
			item.0 Unlocked
			item.1 Locked
		}
	}
